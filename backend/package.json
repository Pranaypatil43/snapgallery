{
  "name": "photo-sharing-backend",
  "version": "1.0.0",
  "description": "Backend API for the Photo Sharing Platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
