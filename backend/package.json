  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cloudinary": "1.41.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.18.3",
    "express-rate-limit": "^7.3.1",
    "express-session": "^1.18.1",
    "express-validator": "7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "9.0.2",
    "mongodb": "^7.6.0",
    "mongoose": "8.2.4",
    "multer": "1.4.5-lts.1",
    "multer-storage-cloudinary": "4.0.0",
    "nanoid": "3.3.7",
    "nodemailer": "^6.9.13",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "mongodb-memory-server": "9.1.1",
    "nodemon": "3.1.0",
    "supertest": "6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
