# Normalize line endings
* text=auto
*.js   text eol=lf
*.jsx  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.html text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf

# Binary files — never touch line endings
*.jpg  binary
*.jpeg binary
*.png  binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
